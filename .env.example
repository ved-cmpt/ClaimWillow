# ClaimWillow configuration reference. Copy to .env for local overrides; never commit real values.

# Spring profile: "local" for development, "prod" for hosted environments
SPRING_PROFILES_ACTIVE=local

# Database connection (Spring Boot conventions)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/claimwillow
SPRING_DATASOURCE_USERNAME=claimwillow
SPRING_DATASOURCE_PASSWORD=<set-a-password>

# Password for the local Docker Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=<set-a-password>

# Session cookie Secure flag; must be true behind HTTPS
SESSION_COOKIE_SECURE=false

# Synthetic demo data seeding (development only; default false)
APP_SEED_DEMO_DATA=false
# Password applied to every seeded synthetic demo account (required when seeding)
APP_SEED_DEMO_PASSWORD=<set-a-nontrivial-password>

# Attachment storage: local | azure
ATTACHMENT_STORAGE_MODE=local
ATTACHMENT_LOCAL_DIR=./data/attachments
# Used only when ATTACHMENT_STORAGE_MODE=azure (not implemented yet)
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_BLOB_CONTAINER=<private-container-name>

# HTTP port
PORT=8080
